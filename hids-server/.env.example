# HTTP
BIND_ADDR=127.0.0.1:8000
INGEST_MAX_BODY_MB=32

# Optional ingest/control-plane auth.
# INGEST_TOKEN=change-me
# HIDS_API_KEY=change-me
# HIDS_COMMAND_KEY=64-hex-characters-or-32-byte-base64-key

# Elasticsearch
ES_URL=http://127.0.0.1:9200
ES_INDEX=hids-events
ES_ALERTS_INDEX=hids-alerts
ES_ALERTS_ENABLED=true
ES_ALERTS_MIN_LEVEL=low
ES_USERNAME=elastic
ES_PASSWORD=elastic
# 生产建议按日滚动索引，便于 ILM 与冷热分层
ES_DAILY_INDEX=true
ES_DOCUMENT_ID=true
ES_MAX_RETRIES=5
ES_RETRY_BASE_MS=200

# Ingest pipeline
QUEUE_CAPACITY=50000
BATCH_SIZE=1000
FLUSH_MS=200
SPOOL_ON_ES_FAILURE=true
SPOOL_DIR=./spool-server

# 可选：丢弃纯 SYN 非敏感端口 flow（降低扫描噪声，默认 false）
# FLOW_DROP_PLAIN_SYN=true

# Threat preprocessing
THREAT_SYN_WINDOW_SEC=1
THREAT_SYN_THRESHOLD=15
# THREAT_RULES_PATH=rules/threat-rules.yaml
# THREAT_RULES_DISABLE=false

RUST_LOG=info,hids_server=debug

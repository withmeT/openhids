# HTTP
BIND_ADDR=127.0.0.1:8000
INGEST_MAX_BODY_MB=32

# Optional ingest auth (leave empty for dev). Agent unchanged unless you add headers later.
# INGEST_TOKEN=change-me
# HIDS_API_KEY=change-me

# Elasticsearch
ES_URL=http://127.0.0.1:9200
ES_INDEX=hids-events
ES_USERNAME=elastic
ES_PASSWORD=elastic
ES_DAILY_INDEX=false
ES_DOCUMENT_ID=true
ES_MAX_RETRIES=5
ES_RETRY_BASE_MS=200

# Ingest pipeline
QUEUE_CAPACITY=50000
BATCH_SIZE=1000
FLUSH_MS=200
SPOOL_ON_ES_FAILURE=true
SPOOL_DIR=./spool-server

# Threat preprocessing
THREAT_SYN_WINDOW_SEC=1
THREAT_SYN_THRESHOLD=15

RUST_LOG=info,hids_server=debug

BIND_ADDR=127.0.0.1:8000
ES_URL=http://127.0.0.1:9200
ES_INDEX=hids-events
ES_USERNAME=elastic
ES_PASSWORD=elastic
QUEUE_CAPACITY=50000
BATCH_SIZE=1000
FLUSH_MS=200
RUST_LOG=info,hids_server=debug

# Threat preprocessing (optional)
# THREAT_SYN_WINDOW_SEC=1
# THREAT_SYN_THRESHOLD=15
# GENERATED FROM .env.example
# Do not commit this file. (Already ignored by .gitignore.)

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# HIDS API auth (optional). If empty, API is open (dev mode).
HIDS_API_KEY=

# Redis (queue for buffering events)
HIDS_REDIS_URL=redis://:123456@127.0.0.1:6379/0
HIDS_REDIS_QUEUE=hids:events

# Elasticsearch
HIDS_ES_URL=http://127.0.0.1:9200
HIDS_ES_USER=elastic
HIDS_ES_PASSWORD=elastic
HIDS_ES_VERIFY_CERTS=0
HIDS_ES_INDEX=hids-events-v1
HIDS_ES_TIMEOUT_SECONDS=30

# ES index settings
HIDS_ES_SHARDS=1
HIDS_ES_REPLICAS=0

HIDS_DB_ENGINE=sqlite

# # MySQL (optional; default uses sqlite)
# HIDS_DB_ENGINE=mysql
# HIDS_DB_NAME=hids
# HIDS_DB_USER=root
# HIDS_DB_PASSWORD=mimaSHI521...
# HIDS_DB_HOST=127.0.0.1

### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Local secrets and runtime configuration
.env
.env.*
!.env.example
!*.env.example
hids-agent.json
hids-agent.local.json
hids-agent.*.local.json

# Local runtime and generated outputs
spool/
spool-server/
hids-server/spool-server/
graphify-out/
dist/
releases/
downloads/
*.log

# Local tool state
.claude/
.vscode/
.idea/
CLAUDE.md
.graphifyignore

# Internal working notes, not release documentation
OPTIMIZATION_*.md

# Python/editor/OS cache
__pycache__/
*.pyc
.pytest_cache/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local-only dev notes (never publish)
PROGRESS.md
demo.md
test.md
建议.md
GRAPH_REPORT.md

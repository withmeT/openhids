{
  "host_id": null,

  "ingest_url": "http://127.0.0.1:8000/ingest",

  "flush_bytes": 1048576,
  "flush_interval_ms": 2000,
  "flush_max_events": 2000,

  "spool_dir": "./spool",
  "spool_max_bytes": 104857600,

  "mem_queue_max_bytes": 10485760,
  "max_send_batches_per_iter": 2,

  "spool_drain_interval_secs": 2,

  "config_reload_interval_secs": 5,

  "xdp_enabled": true,
  "xdp_iface": "auto",
  "xdp_skip_ips": [],
  "xdp_capture_all_ports": false,
  "xdp_sensitive_ports": [22, 80, 443, 3306, 6379, 8080, 8000, 9200],
  "http_l7_ports": [80, 8080, 8000, 9200],

  "http_l7_dedup_window_ms": 2000,
  "http_l7_ignore_path_prefixes": ["/favicon.ico", "/robots.txt"],
  "http_l7_ignore_path_suffixes": [".js", ".css", ".ico", ".woff", ".woff2", ".map"],

  "http_l7_capture_response": true,

  "proc_monitor_enabled": true,
  "file_watch_paths": ["/etc"]
}


# HTTP
BIND_ADDR=0.0.0.0:8000
INGEST_MAX_BODY_MB=32

# Ingest auth (生产环境必须设置；不设置时所有摄取请求返回 401)
INGEST_TOKEN=change-me

# 加密控制面（基线核查命令下发），32 字节 hex；不设置则 /commands* 不可用
# HIDS_COMMAND_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Elasticsearch
ES_URL=http://127.0.0.1:9200
ES_INDEX=hids-events
ES_USERNAME=elastic
ES_PASSWORD=change-me
ES_DAILY_INDEX=true
ES_DOCUMENT_ID=true
ES_MAX_RETRIES=5
ES_RETRY_BASE_MS=200

# 告警双写
ES_ALERTS_ENABLED=true
ES_ALERTS_INDEX=hids-alerts
ES_ALERTS_MIN_LEVEL=medium

# Ingest pipeline
QUEUE_CAPACITY=50000
BATCH_SIZE=1000
FLUSH_MS=200
SPOOL_ON_ES_FAILURE=true
SPOOL_DIR=./spool-server

# Threat preprocessing
THREAT_SYN_WINDOW_SEC=1
THREAT_SYN_THRESHOLD=15
# THREAT_RULES_PATH=rules/threat-rules.yaml   # 默认即项目内 rules/
# THREAT_RULES_DISABLE=false

# Web 控制台静态目录（默认即项目内 static/）
# STATIC_DIR=static
